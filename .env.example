# Copy this file to ".env" and fill in your credentials.
# The real .env is gitignored — never commit it.

# --- Shopify (Dev Dashboard app + client_credentials grant) ---
# NOTE: legacy custom apps (static shpat_ tokens) were discontinued Jan 1, 2026.
# Manage the app in the Dev Dashboard. Set Admin API scopes in its Access section
# (read_orders, read_products; read_all_orders for >60d history) and INSTALL it on the store.
# The code mints a 24h token via:
#   POST https://{SHOPIFY_STORE_DOMAIN}/admin/oauth/access_token
#   grant_type=client_credentials&client_id=...&client_secret=...
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-01

# --- Printify (Personal Access Token) ---
# Create at: Printify -> Account settings -> Connections -> Generate token
# Paste the token here.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# --- Meta Marketing API ---
# Create a Meta app with a system user; generate a system-user token with ads_read.
META_APP_ID=
META_AD_ACCOUNT_ID=act_XXXXXXXXXX
META_SYSTEM_USER_TOKEN=
META_API_VERSION=v21.0

# --- Supabase Postgres ---
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Use the "Session pooler" / direct connection URI. Looks like:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Job settings ---
# How many days back to pull each night (>60 needs read_all_orders on Shopify).
SYNC_LOOKBACK_DAYS=60

# --- Recommendation economics (fallbacks when a shirt has no Printify match) ---
# Real per-shirt print cost comes from Printify; these are only used for ad sets
# not yet mapped to a shirt via utm_campaign=shirt_<id>.
DEFAULT_UNIT_COGS=11.00
DEFAULT_PRICE=24.99

# --- Fixed monthly overhead (optional) ---
# Not in any per-order API: Shopify plan + Printify subscription + app fees.
# Set this to see TRUE net profit (it is prorated into the dashboard P&L). 0 = ignore.
MONTHLY_FIXED_COSTS=0

# --- AI design ideas (optional) ---
# Only the dashboard's "Generate ideas" panel needs this. Everything else works
# without it. Get a key from console.anthropic.com.
ANTHROPIC_API_KEY=
IDEAS_MODEL=claude-opus-4-8
